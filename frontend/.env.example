# Central Tracking Dashboard - Environment Configuration Template
# Copy this file to .env.local to customize your environment.

# Base URL for the NestJS Backend API. The backend has no /api/v1 prefix: routes are /auth/login, /auth/me, ...
# Frontend and API must be on the same site (e.g. both on localhost, or app.example.com + api.example.com): the session cookie is SameSite=Lax.
# The backend's CORS_ORIGIN must list this app's origin.
# Local layout of the team: backend on :3000 (backend/.env PORT=3000), frontend on :3001 ("npm run dev:backend"),
# backend/.env CORS_ORIGIN=http://localhost:3001. Step by step: docs/menghubungkan-backend.md. Check it with "npm run check:backend".
NEXT_PUBLIC_API_URL=http://localhost:3000

# Data Layer Mode:
# 'true'  -> Uses high-fidelity local simulation mock adapter (default before backend is ready)
# 'false' -> Routes requests to the real NestJS API server, and logs in through it (POST /auth/login, httpOnly cookie, CSRF).
# Connect parts one at a time: keep NEXT_PUBLIC_USE_MOCK=true and list what talks to the backend in NEXT_PUBLIC_API_MODULES
# (auth, tickets, people, roles). Anything not listed keeps the local mock data. 'tickets', 'people' and 'roles' need 'auth'.
# Without 'auth' here, the login page checks the built-in demo accounts and never calls the backend.
# Comment the line out to run the whole app on mock data without a backend.
#           No demo accounts and no password live in the browser in this mode.
NEXT_PUBLIC_API_MODULES=auth,tickets,people,roles
NEXT_PUBLIC_USE_MOCK=true

# Mock Adapter Artificial Latency (in milliseconds)
# Random delay is picked between MIN and MAX to simulate realistic network latency
NEXT_PUBLIC_MOCK_DELAY_MIN=500
NEXT_PUBLIC_MOCK_DELAY_MAX=1500

# API Client Request Timeout (in milliseconds, default: 15000 = 15s)
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Demo login (accounts built into the frontend). Always on in development; a production build has NO demo accounts
# unless this is 'true'. Leave it unset in production: log in through the real backend instead.
# NEXT_PUBLIC_ALLOW_DEMO_LOGIN=false

# Development-only test account (git-ignored .env.local). Ignored by production builds. Never put a real password here.
# NEXT_PUBLIC_LOCAL_TEST_EMAIL=
# NEXT_PUBLIC_LOCAL_TEST_PASSWORD=

# Server-side route gate (not NEXT_PUBLIC). 'true': an app page without the backend's ctd.sid cookie redirects to /login before it renders.
# Only turn on when the cookie reaches this server (same host as the API, or a shared parent domain).
# AUTH_COOKIE_GUARD=false

# --- Handover API (server env, not NEXT_PUBLIC). See docs/frontend-auth.md ---
# With "auth" in NEXT_PUBLIC_API_MODULES (or NEXT_PUBLIC_USE_MOCK=false) the handover caller is the backend session user: this server
# checks the browser's ctd.sid cookie with GET /auth/me on the backend, and the settings below about identity no longer apply.
# Where this server reaches the backend, when not at NEXT_PUBLIC_API_URL (an internal address in production).
# HANDOVER_BACKEND_URL=
# Without the backend login: believe the oai-authenticated-user-* identity headers. REQUIRED when hosted behind the platform that sets them; keep off anywhere else.
# HANDOVER_TRUST_OAI_HEADERS=true
# Built-in demo operator outside development (demos only).
# HANDOVER_SIMULATED_ACTOR=false
# Extra origins allowed to write, comma separated.
# HANDOVER_ALLOWED_ORIGINS=
# Behind a reverse proxy: believe X-Forwarded-Host / X-Forwarded-Proto.
# TRUST_FORWARDED_HEADERS=false

# --- Build for users (production) ---
# The pipeline that builds what users open sets this (build time, not NEXT_PUBLIC). It turns the checks in scripts/check-production-env.mjs
# (run by "npm run build") from warnings into errors: demo login, HANDOVER_SIMULATED_ACTOR, no backend login, API URL missing or not https.
# CTD_DEPLOY_ENV=production

# The https:// address users open (build time). Turns on HSTS and upgrade-insecure-requests, sets the absolute URLs in page metadata, and
# sends an http visit to this address. Required when CTD_DEPLOY_ENV=production. Leave unset for localhost, LAN or plain-http test servers.
# NEXT_PUBLIC_SITE_URL=https://ctd.example.id

# Dev server only: host names it may answer to besides localhost and IP addresses (a tunnel, a shared dev domain), comma separated; "*" = any.
# CTD_DEV_ALLOWED_HOSTS=
