# =============================================================================
# Central Tracking Dashboard - Template Konfigurasi Frontend
# =============================================================================
# Cara pakai:
#   1. Salin file ini menjadi .env.local  ->  cp .env.example .env.local
#   2. Sesuaikan nilainya (default di bawah sudah cocok untuk lokal)
#   3. Restart dev server setiap kali .env.local diubah
#
# Panduan lengkap: docs/menghubungkan-backend.md
# =============================================================================


# -----------------------------------------------------------------------------
# 1. KONEKSI BACKEND (WAJIB)
# -----------------------------------------------------------------------------
# Alamat dasar backend NestJS, TANPA "/api" dan TANPA "/" di akhir.
# Contoh rute backend: /auth/login, /auth/me.
#   Lokal    : http://localhost:3000
#   Produksi : https://api.example.id
#
# Frontend dan backend harus satu situs (cookie sesi SameSite=Lax), dan
# CORS_ORIGIN di backend/.env harus memuat alamat frontend ini.
NEXT_PUBLIC_API_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 2. MODE DATA: MOCK ATAU BACKEND
# -----------------------------------------------------------------------------
# true  = memakai data contoh di browser (default, backend belum perlu jalan)
# false = semua data dan login lewat backend
NEXT_PUBLIC_USE_MOCK=true

# Sambungkan bertahap: biarkan NEXT_PUBLIC_USE_MOCK=true, lalu daftar modul
# yang sudah memakai backend. Modul lain tetap memakai data mock.
#   auth,tickets,people,roles  = semua modul yang tersedia
#   auth                       = hanya login, sisanya masih mock
# Catatan: tickets, people, dan roles membutuhkan "auth".
# Tanpa "auth", halaman login hanya memeriksa akun demo dan tidak pernah
# memanggil backend. Kosongkan baris ini untuk memakai mock penuh.
NEXT_PUBLIC_API_MODULES=auth,tickets,people,roles


# -----------------------------------------------------------------------------
# 3. SIMULASI MOCK (opsional)
# -----------------------------------------------------------------------------
# Jeda buatan acak antara MIN dan MAX (ms) agar mock terasa seperti jaringan
# sungguhan. Bisa dilewati saat testing dengan URL ?mock=0 atau ?mock=slow.
NEXT_PUBLIC_MOCK_DELAY_MIN=500
NEXT_PUBLIC_MOCK_DELAY_MAX=1500

# Peran default saat memakai mock tanpa login backend.
# Pilihan: manager | lead | operator | viewer
# NEXT_PUBLIC_MOCK_ROLE=manager


# -----------------------------------------------------------------------------
# 4. KLIEN API
# -----------------------------------------------------------------------------
# Batas waktu satu request ke backend (ms). Default 15000 = 15 detik.
NEXT_PUBLIC_API_TIMEOUT_MS=15000


# -----------------------------------------------------------------------------
# 5. AKUN DEMO & AKUN UJI LOKAL
# -----------------------------------------------------------------------------
# Akun demo selalu aktif saat development. Untuk build produksi, biarkan
# kosong atau false dan login lewat backend.
# NEXT_PUBLIC_ALLOW_DEMO_LOGIN=false

# Akun uji otomatis. Hanya dibaca saat development, diabaikan oleh build
# produksi, dan tidak boleh berisi password asli. .env.local tidak masuk git.
# NEXT_PUBLIC_LOCAL_TEST_EMAIL=
# NEXT_PUBLIC_LOCAL_TEST_PASSWORD=
# NEXT_PUBLIC_LOCAL_TEST_NAME=Local Test Operator
# NEXT_PUBLIC_LOCAL_TEST_EMPLOYEE_ID=EMP-LOCAL
# NEXT_PUBLIC_LOCAL_TEST_ROLE=Operator NOC
# NEXT_PUBLIC_LOCAL_TEST_SHIFT=Malam


# -----------------------------------------------------------------------------
# 6. SESI & KEAMANAN SERVER
# -----------------------------------------------------------------------------
# true = halaman aplikasi tanpa cookie ctd.sid langsung dialihkan ke /login
# sebelum dirender. Aktifkan hanya jika cookie bisa sampai ke server ini
# (host sama dengan API, atau berbagi parent domain).
# AUTH_COOKIE_GUARD=false

# Percayai header X-Forwarded-Host / X-Forwarded-Proto dari reverse proxy.
# TRUST_FORWARDED_HEADERS=false


# -----------------------------------------------------------------------------
# 7. API HANDOVER (server-side, bukan NEXT_PUBLIC)
# -----------------------------------------------------------------------------
# Saat "auth" aktif di NEXT_PUBLIC_API_MODULES (atau NEXT_PUBLIC_USE_MOCK=false),
# identitas handover diambil dari sesi backend: server ini memeriksa cookie
# ctd.sid lewat GET /auth/me. Pengaturan identitas di bawah tidak dipakai.
#
# Alamat backend yang dilihat oleh server ini, jika berbeda dengan alamat publik
# (misalnya alamat internal di produksi).
# HANDOVER_BACKEND_URL=

# Tanpa login backend: percayai header identitas oai-authenticated-user-*.
# WAJIB hanya jika aplikasi berada di belakang platform yang mengisi header
# tersebut; jangan dinyalakan di tempat lain.
# HANDOVER_TRUST_OAI_HEADERS=true

# Operator demo bawaan di luar development (khusus demonstrasi).
# HANDOVER_SIMULATED_ACTOR=false

# Origin tambahan yang boleh menulis, dipisahkan koma.
# HANDOVER_ALLOWED_ORIGINS=


# -----------------------------------------------------------------------------
# 8. PRODUKSI (build)
# -----------------------------------------------------------------------------
# Diisi oleh pipeline build. Nilainya mengubah peringatan di
# scripts/check-production-env.mjs menjadi error: akun demo aktif,
# HANDOVER_SIMULATED_ACTOR aktif, login backend tidak aktif, atau
# NEXT_PUBLIC_API_URL bukan https.
# CTD_DEPLOY_ENV=production

# Alamat https yang dibuka pengguna. Wajib saat produksi: mengaktifkan HSTS,
# upgrade-insecure-requests, dan URL absolut di metadata halaman. Biarkan
# kosong untuk localhost, LAN, atau server uji http biasa.
# NEXT_PUBLIC_SITE_URL=https://ctd.example.id


# -----------------------------------------------------------------------------
# 9. DEV SERVER (opsional)
# -----------------------------------------------------------------------------
# Nama host tambahan yang boleh dijawab dev server, dipisahkan koma
# (misalnya host tunnel). "*" = semua host.
# CTD_DEV_ALLOWED_HOSTS=

# Alamat frontend saat menjalankan "npm run check:backend", kalau bukan
# http://localhost:3001.
# CTD_FRONTEND_ORIGIN=http://localhost:3001
