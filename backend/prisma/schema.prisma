generator client {
  provider        = "prisma-client"
  // Needed for `extensions = [citext]` below.
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  // citext: case-insensitive text, used where uniqueness and lookups must ignore
  // case (emails, role/category names, severity codes).
  extensions = [citext]
}

// Conventions: all timestamps are timestamptz (stored as UTC instants); every
// foreign key column that is filtered or joined on has an index.

// ─────────────────────────────────────────────
// Users & roles
// ─────────────────────────────────────────────

model User {
  id         BigInt   @id @default(autoincrement())
  name       String   @db.VarChar(255)
  nik        String?  @unique @db.VarChar(255)
  // citext: unique and matched (e.g. at login) regardless of case.
  email      String   @unique @db.Citext
  role_id    BigInt?
  is_active  Boolean  @default(true)
  password   String?  @db.VarChar(100)
  photo_url  String?  @db.VarChar(500)
  department String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  role                  UserRole?        @relation(fields: [role_id], references: [id], onUpdate: NoAction)
  acknowledgedHandovers Handover[]       @relation("HandoverAcknowledgedBy")
  updatedHandovers      Handover[]       @relation("HandoverUpdatedBy")
  routineMeetings       RoutineMeeting[]
  routineReports        RoutineReport[]
  ticketLogs            TicketLog[]

  @@index([role_id])
  @@map("users")
}

model UserRole {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.Citext
  description String?  @db.VarChar(500)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  users       User[]
  permissions RolePermission[]

  @@map("user_role")
}

// Catalogue of permissions. Rows are registered by the app at startup from
// definePermission() calls in code; descriptions are editable via the API.
model Permission {
  key         String    @id @db.VarChar(100)
  description String?
  // Set when the running code no longer defines this key; cleared if it returns.
  obsolete_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

// Which role has which permission.
model RolePermission {
  role_id        BigInt
  permission_key String   @db.VarChar(100)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  role       UserRole   @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permission_key], references: [key], onDelete: Restrict, onUpdate: Cascade)

  @@id([role_id, permission_key])
  @@index([permission_key])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// Organisation
// ─────────────────────────────────────────────

model Tenant {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(255)
  detail_info String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  projects            Project[]
  monitoringLogs      MonitoringLog[]
  monitoringTemplates MonitoringTemplate[]
  ticketLogs          TicketLog[]

  @@map("tenants")
}

model Project {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(255)
  tenant_id   BigInt
  code_prefix String?  @db.VarChar(100)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant              Tenant               @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  handovers           Handover[]
  monitoringLogs      MonitoringLog[]
  monitoringTemplates MonitoringTemplate[]
  routineMeetings     RoutineMeeting[]
  routineReports      RoutineReport[]
  ticketLogs          TicketLog[]

  @@index([tenant_id])
  @@map("projects")
}

model Client {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(255)
  detail_info String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  ticketLogs TicketLog[]

  @@map("clients")
}

// ─────────────────────────────────────────────
// Tickets
// ─────────────────────────────────────────────

model TicketLog {
  id                    BigInt       @id @default(autoincrement())
  third_party_ticket_id String?      @db.VarChar(100)
  project_id            BigInt
  client_id             BigInt?
  tenant_id             BigInt?
  user_id               BigInt?
  severity_id           BigInt?
  category_id           BigInt?
  requester             String?      @db.VarChar(100)
  subject               String       @db.VarChar(500)
  description           String?
  status                TicketStatus @default(Open)
  open_at               DateTime     @default(now()) @db.Timestamptz(6)
  closed_at             DateTime?    @db.Timestamptz(6)
  created_at            DateTime     @default(now()) @db.Timestamptz(6)
  updated_at            DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  project  Project         @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  client   Client?         @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant   Tenant?         @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user     User?           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  severity TicketSeverity? @relation(fields: [severity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category TicketCategory? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // The list's default sort, its filters and the status summary.
  @@index([open_at(sort: Desc)])
  @@index([status])
  @@index([project_id, open_at(sort: Desc)])
  @@index([user_id])
  @@index([tenant_id])
  @@index([client_id])
  @@index([severity_id])
  @@index([category_id])
  @@map("ticket_logs")
}

model TicketCategory {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.Citext
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  ticketLogs TicketLog[]

  @@map("ticket_categories")
}

model TicketSeverity {
  id         BigInt   @id @default(autoincrement())
  code_name  String   @unique @db.Citext
  name       String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  ticketLogs TicketLog[]

  @@map("ticket_severities")
}

// ─────────────────────────────────────────────
// Routine operations
// ─────────────────────────────────────────────

model Handover {
  id                  BigInt            @id @default(autoincrement())
  updated_user_id     BigInt?
  acknowledge_user_id BigInt?
  project_id          BigInt?
  content             String?
  status              RoutineStatus?    @default(Open)
  category            HandoverCategory?
  is_repeatable       Boolean           @default(false)
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  updatedBy      User?    @relation("HandoverUpdatedBy", fields: [updated_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  acknowledgedBy User?    @relation("HandoverAcknowledgedBy", fields: [acknowledge_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project        Project? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id])
  @@index([updated_user_id])
  @@index([acknowledge_user_id])
  @@map("handover")
}

model RoutineMeeting {
  id                  BigInt         @id @default(autoincrement())
  project_id          BigInt?
  pic_user_id         BigInt?
  meeting_name        String?        @db.VarChar(255)
  start_at            DateTime?      @db.Timestamptz(6)
  target_completed_at DateTime?      @db.Timestamptz(6)
  status_update       String?        @db.VarChar(500)
  meeting_room_url    String?
  status              RoutineStatus? @default(Open)
  is_temporary        Boolean        @default(false)
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  pic     User?    @relation(fields: [pic_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project Project? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id])
  @@index([pic_user_id])
  @@map("routine_meetings")
}

model RoutineReport {
  id                  BigInt         @id @default(autoincrement())
  project_id          BigInt?
  pic_user_id         BigInt?
  report_name         String?        @db.VarChar(255)
  start_at            DateTime?      @db.Timestamptz(6)
  target_completed_at DateTime?      @db.Timestamptz(6)
  status_update       String?        @db.VarChar(500)
  doc_url             String?
  status              RoutineStatus? @default(Open)
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  pic     User?    @relation(fields: [pic_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project Project? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id])
  @@index([pic_user_id])
  @@map("routine_reports")
}

model MonitoringLog {
  id                     BigInt    @id @default(autoincrement())
  project_id             BigInt?
  tenant_id              BigInt?
  log_date               DateTime? @db.Date
  checkpoint_time        DateTime? @db.Time(6)
  checkpoint_description String?   @db.VarChar(255)
  result_note            String?
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  project Project? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant  Tenant?  @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id, log_date])
  @@index([tenant_id])
  @@map("monitoring_logs")
}

model MonitoringTemplate {
  id                     BigInt    @id @default(autoincrement())
  project_id             BigInt?
  tenant_id              BigInt?
  log_date               DateTime? @db.Date
  checkpoint_time        DateTime? @db.Time(6)
  checkpoint_description String?   @db.VarChar(255)
  result_note            String?
  is_temporary           Boolean   @default(false)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  project Project? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant  Tenant?  @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id])
  @@index([tenant_id])
  @@map("monitoring_template")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum HandoverCategory {
  Note
  Task
  Monitoring

  @@map("handover_category_enum")
}

enum RoutineStatus {
  Open
  Closed
  ReOpen
  Pending

  @@map("routine_status_enum")
}

enum TicketStatus {
  Open
  Closed
  Activity
  Meeting
  Pending
  ReOpen

  @@map("ticket_status_enum")
}
