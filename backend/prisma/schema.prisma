generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Users & roles
// ─────────────────────────────────────────────

model User {
  id         BigInt   @id @default(autoincrement())
  name       String?  @db.VarChar(255)
  nik        String?  @unique @db.VarChar(255)
  email      String?  @unique @db.VarChar(255)
  role_id    BigInt?
  is_active  Boolean  @default(true)
  password   String?  @db.VarChar(100)
  photo_url  String?  @db.VarChar(500)
  department String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  role                  UserRole?        @relation(fields: [role_id], references: [id], onUpdate: NoAction)
  acknowledgedHandovers Handover[]       @relation("HandoverAcknowledgedBy")
  updatedHandovers      Handover[]       @relation("HandoverUpdatedBy")
  routineMeetings       RoutineMeeting[]
  routineReports        RoutineReport[]
  ticketLogs            TicketLog[]

  @@map("users")
}

model UserRole {
  id         BigInt   @id @default(autoincrement())
  name       String   @db.VarChar(500)
  privilege  String?
  info       String?  @db.VarChar(500)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  users User[]

  @@map("user_role")
}

// ─────────────────────────────────────────────
// Organisation
// ─────────────────────────────────────────────

model Tenant {
  id          BigInt   @id @default(autoincrement())
  name        String?  @db.VarChar(255)
  detail_info String?
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(6)

  projects            Project[]
  monitoringLogs      MonitoringLog[]
  monitoringTemplates MonitoringTemplate[]
  ticketLogs          TicketLog[]

  @@map("tenants")
}

model Project {
  id          BigInt   @id @default(autoincrement())
  name        String?  @db.VarChar(255)
  tenant_id   BigInt?
  code_prefix String?  @db.VarChar(100)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(6)

  tenant              Tenant?              @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  handovers           Handover[]
  monitoringLogs      MonitoringLog[]
  monitoringTemplates MonitoringTemplate[]
  routineMeetings     RoutineMeeting[]
  routineReports      RoutineReport[]
  ticketLogs          TicketLog[]

  @@map("projects")
}

model Client {
  id          BigInt   @id @default(autoincrement())
  name        String?  @db.VarChar(255)
  detail_info String?
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(6)

  ticketLogs TicketLog[]

  @@map("clients")
}

// ─────────────────────────────────────────────
// Tickets
// ─────────────────────────────────────────────

model TicketLog {
  id                    BigInt        @id @default(autoincrement())
  third_party_ticket_id String?       @db.VarChar(100)
  project_id            BigInt?
  client_id             BigInt?
  tenant_id             BigInt?
  user_id               BigInt?
  severity_id           BigInt?
  category_id           BigInt?
  requester             String?       @db.VarChar(100)
  subject               String?       @db.VarChar(500)
  description           String?
  status                TicketStatus? @default(Open)
  closed_at             DateTime?     @db.Timestamp(6)
  open_at               DateTime?     @db.Timestamp(6)
  created_at            DateTime      @default(now()) @db.Timestamp(6)
  updated_at            DateTime      @default(now()) @updatedAt @db.Timestamp(6)

  project  Project?        @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  client   Client?         @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant   Tenant?         @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user     User?           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  severity TicketSeverity? @relation(fields: [severity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category TicketCategory? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("ticket_logs")
}

model TicketCategory {
  id          BigInt   @id @default(autoincrement())
  name        String?  @db.VarChar(255)
  description String?
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(6)

  ticketLogs TicketLog[]

  @@map("ticket_categories")
}

model TicketSeverity {
  id         BigInt   @id @default(autoincrement())
  code_name  String?  @db.VarChar(50)
  name       String?  @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  ticketLogs TicketLog[]

  @@map("ticket_severities")
}

// ─────────────────────────────────────────────
// Routine operations
// ─────────────────────────────────────────────

model Handover {
  id                  BigInt            @id @default(autoincrement())
  updated_user_id     BigInt?
  acknowledge_user_id BigInt?
  project_id          BigInt?
  content             String?
  status              RoutineStatus?    @default(Open)
  category            HandoverCategory?
  is_repeatable       Boolean           @default(false)
  created_at          DateTime          @default(now()) @db.Timestamp(6)
  updated_at          DateTime          @default(now()) @updatedAt @db.Timestamp(6)

  updatedBy      User?    @relation("HandoverUpdatedBy", fields: [updated_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  acknowledgedBy User?    @relation("HandoverAcknowledgedBy", fields: [acknowledge_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project        Project? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("handover")
}

model RoutineMeeting {
  id                  BigInt         @id @default(autoincrement())
  project_id          BigInt?
  pic_user_id         BigInt?
  meeting_name        String?        @db.VarChar(255)
  start_at            DateTime?      @db.Timestamp(6)
  target_completed_at DateTime?      @db.Timestamp(6)
  status_update       String?        @db.VarChar(500)
  meeting_room_url    String?
  status              RoutineStatus? @default(Open)
  is_temporary        Boolean        @default(false)
  created_at          DateTime       @default(now()) @db.Timestamp(6)
  updated_at          DateTime       @default(now()) @updatedAt @db.Timestamp(6)

  pic     User?    @relation(fields: [pic_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project Project? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("routine_meetings")
}

model RoutineReport {
  id                  BigInt         @id @default(autoincrement())
  project_id          BigInt?
  pic_user_id         BigInt?
  report_name         String?        @db.VarChar(255)
  start_at            DateTime?      @db.Timestamp(6)
  target_completed_at DateTime?      @db.Timestamp(6)
  status_update       String?        @db.VarChar(500)
  doc_url             String?
  status              RoutineStatus? @default(Open)
  created_at          DateTime       @default(now()) @db.Timestamp(6)
  updated_at          DateTime       @default(now()) @updatedAt @db.Timestamp(6)

  pic     User?    @relation(fields: [pic_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project Project? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("routine_reports")
}

model MonitoringLog {
  id                     BigInt    @id @default(autoincrement())
  project_id             BigInt?
  tenant_id              BigInt?
  log_date               DateTime? @db.Date
  checkpoint_time        DateTime? @db.Time(6)
  checkpoint_description String?   @db.VarChar(255)
  result_note            String?
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  project Project? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant  Tenant?  @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("monitoring_logs")
}

model MonitoringTemplate {
  id                     BigInt    @id @default(autoincrement())
  project_id             BigInt?
  tenant_id              BigInt?
  log_date               DateTime? @db.Date
  checkpoint_time        DateTime? @db.Time(6)
  checkpoint_description String?   @db.VarChar(255)
  result_note            String?
  is_temporary           Boolean   @default(false)
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  project Project? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant  Tenant?  @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("monitoring_template")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum HandoverCategory {
  Note
  Task
  Monitoring

  @@map("handover_category_enum")
}

enum RoutineStatus {
  Open
  Closed
  ReOpen
  Pending

  @@map("routine_status_enum")
}

enum TicketStatus {
  Open
  Closed
  Activity
  Meeting
  Pending
  ReOpen

  @@map("ticket_status_enum")
}
