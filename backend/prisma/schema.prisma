generator client {
  provider        = "prisma-client"
  // Needed for `extensions = [citext]` below.
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  // citext: case-insensitive text, used where uniqueness and lookups must ignore
  // case (emails, role/category names, severity codes).
  extensions = [citext]
}

// Conventions: all timestamps are timestamptz (stored as UTC instants); every
// foreign key column that is filtered or joined on has an index.

// ─────────────────────────────────────────────
// Users & roles
// ─────────────────────────────────────────────

model User {
  id         BigInt   @id @default(autoincrement())
  name       String   @db.VarChar(255)
  nik        String?  @unique @db.VarChar(255)
  // citext: unique and matched (e.g. at login) regardless of case.
  email      String   @unique @db.Citext
  role_id    BigInt?
  is_active  Boolean  @default(true)
  password   String?  @db.VarChar(100)
  photo_url  String?  @db.VarChar(500)
  department String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  role                  UserRole?        @relation(fields: [role_id], references: [id], onUpdate: NoAction)
  acknowledgedHandovers Handover[]       @relation("HandoverAcknowledgedBy")
  updatedHandovers      Handover[]       @relation("HandoverUpdatedBy")
  routineMeetings       RoutineMeeting[]
  routineReports        RoutineReport[]
  ticketLogs            TicketLog[]

  monitoringTemplatesCreated MonitoringTemplate[] @relation("MonitoringTemplateCreatedBy")
  monitoringLogsDone         MonitoringLog[]      @relation("MonitoringLogCheckedBy")
  monitoringLogsReviewed     MonitoringLog[]      @relation("MonitoringLogReviewedBy")

  @@index([role_id])
  @@map("users")
}

model UserRole {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.Citext
  description String?  @db.VarChar(500)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  users       User[]
  permissions RolePermission[]

  @@map("user_role")
}

// Catalogue of permissions. Rows are registered by the app at startup from
// definePermission() calls in code; descriptions are editable via the API.
model Permission {
  key         String    @id @db.VarChar(100)
  description String?
  // Set when the running code no longer defines this key; cleared if it returns.
  obsolete_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

// Which role has which permission.
model RolePermission {
  role_id        BigInt
  permission_key String   @db.VarChar(100)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  role       UserRole   @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permission_key], references: [key], onDelete: Restrict, onUpdate: Cascade)

  @@id([role_id, permission_key])
  @@index([permission_key])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// Organisation
// ─────────────────────────────────────────────

model Tenant {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(255)
  detail_info String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  projects   Project[]
  ticketLogs TicketLog[]

  @@map("tenants")
}

model Project {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(255)
  tenant_id   BigInt
  code_prefix String?  @db.VarChar(100)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant              Tenant               @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  handovers           Handover[]
  monitoringTemplates MonitoringTemplate[]
  routineMeetings     RoutineMeeting[]
  routineReports      RoutineReport[]
  ticketLogs          TicketLog[]

  @@index([tenant_id])
  @@map("projects")
}

model Client {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(255)
  detail_info String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  ticketLogs          TicketLog[]
  monitoringTemplates MonitoringTemplate[]

  @@map("clients")
}

// ─────────────────────────────────────────────
// Tickets
// ─────────────────────────────────────────────

model TicketLog {
  id                    BigInt       @id @default(autoincrement())
  third_party_ticket_id String?      @db.VarChar(100)
  project_id            BigInt
  client_id             BigInt?
  tenant_id             BigInt?
  user_id               BigInt?
  severity_id           BigInt?
  category_id           BigInt?
  requester             String?      @db.VarChar(100)
  subject               String       @db.VarChar(500)
  description           String?
  status                TicketStatus @default(Open)
  open_at               DateTime     @default(now()) @db.Timestamptz(6)
  closed_at             DateTime?    @db.Timestamptz(6)
  created_at            DateTime     @default(now()) @db.Timestamptz(6)
  updated_at            DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  project  Project         @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  client   Client?         @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant   Tenant?         @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user     User?           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  severity TicketSeverity? @relation(fields: [severity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category TicketCategory? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  monitoringLogs MonitoringLog[]

  // The list's default sort, its filters and the status summary.
  @@index([open_at(sort: Desc)])
  @@index([status])
  @@index([project_id, open_at(sort: Desc)])
  @@index([user_id])
  @@index([tenant_id])
  @@index([client_id])
  @@index([severity_id])
  @@index([category_id])
  @@map("ticket_logs")
}

model TicketCategory {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.Citext
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  ticketLogs TicketLog[]

  @@map("ticket_categories")
}

model TicketSeverity {
  id         BigInt   @id @default(autoincrement())
  code_name  String   @unique @db.Citext
  name       String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  ticketLogs TicketLog[]

  @@map("ticket_severities")
}

// ─────────────────────────────────────────────
// Routine operations
// ─────────────────────────────────────────────

model Handover {
  id                  BigInt            @id @default(autoincrement())
  updated_user_id     BigInt?
  acknowledge_user_id BigInt?
  project_id          BigInt?
  content             String?
  status              RoutineStatus?    @default(Open)
  category            HandoverCategory?
  is_repeatable       Boolean           @default(false)
  // For a Monitoring handover: the (usually NOK) monitoring log it hands over to the next shift.
  monitoring_log_id   BigInt?
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  updatedBy      User?          @relation("HandoverUpdatedBy", fields: [updated_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  acknowledgedBy User?          @relation("HandoverAcknowledgedBy", fields: [acknowledge_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project        Project?       @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  monitoringLog  MonitoringLog? @relation(fields: [monitoring_log_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id])
  @@index([updated_user_id])
  @@index([acknowledge_user_id])
  @@index([monitoring_log_id])
  @@map("handover")
}

model RoutineMeeting {
  id                  BigInt         @id @default(autoincrement())
  project_id          BigInt?
  pic_user_id         BigInt?
  meeting_name        String?        @db.VarChar(255)
  start_at            DateTime?      @db.Timestamptz(6)
  target_completed_at DateTime?      @db.Timestamptz(6)
  status_update       String?        @db.VarChar(500)
  meeting_room_url    String?
  status              RoutineStatus? @default(Open)
  is_temporary        Boolean        @default(false)
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  pic     User?    @relation(fields: [pic_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project Project? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id])
  @@index([pic_user_id])
  @@map("routine_meetings")
}

model RoutineReport {
  id                  BigInt         @id @default(autoincrement())
  project_id          BigInt?
  pic_user_id         BigInt?
  report_name         String?        @db.VarChar(255)
  start_at            DateTime?      @db.Timestamptz(6)
  target_completed_at DateTime?      @db.Timestamptz(6)
  status_update       String?        @db.VarChar(500)
  doc_url             String?
  status              RoutineStatus? @default(Open)
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  pic     User?    @relation(fields: [pic_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project Project? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id])
  @@index([pic_user_id])
  @@map("routine_reports")
}

// Monitoring template: what to check and when, e.g. "check node lastcoll on
// smng232" for a project at 09:00, 13:00 and 17:00 WIB every day.
// The tenant comes from the project (no tenant_id).
model MonitoringTemplate {
  id           BigInt    @id @default(autoincrement())
  project_id   BigInt
  name         String    @db.VarChar(255)
  // How to check and what counts as OK.
  instructions String?
  // Local times of day, "HH:mm" (e.g. ["09:00","13:00","17:00"]), in `timezone`.
  times        String[]
  timezone     String    @default("Asia/Jakarta") @db.VarChar(64)
  // Temporary templates: limited by a date range, and/or switched off when
  // the client no longer needs them.
  is_temporary Boolean   @default(false)
  active_from  DateTime? @db.Date // null: from creation
  active_until DateTime? @db.Date // null: open-ended
  // Off = no longer scheduled; history is kept (never delete a template with logs).
  is_active    Boolean   @default(true)
  // The client who asked for it (e.g. a temporary, client-requested template).
  client_id    BigInt?
  created_by   BigInt?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  project   Project         @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  client    Client?         @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy User?           @relation("MonitoringTemplateCreatedBy", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  logs      MonitoringLog[]

  @@index([project_id])
  @@index([is_active])
  @@index([client_id])
  @@index([created_by])
  @@map("monitoring_templates")
}

// Monitoring log: one check of a template at one scheduled time, done by an
// agent and optionally reviewed by a team lead. A slot with no row is "missed"
// (computed, not stored).
model MonitoringLog {
  id           BigInt           @id @default(autoincrement())
  template_id  BigInt
  // The scheduled slot (e.g. today 09:00 WIB) as an exact instant.
  scheduled_at DateTime         @db.Timestamptz(6)
  // When the agent actually did it.
  checked_at   DateTime         @default(now()) @db.Timestamptz(6)
  checked_by   BigInt
  result       MonitoringResult
  // Required when result is NOK (enforced by the API, not the DB).
  note         String?
  // Optional image/screenshot link (e.g. for a NOK).
  evidence_url String?
  // Optional ticket raised for a NOK.
  ticket_id    BigInt?
  reviewed_by  BigInt?
  reviewed_at  DateTime?        @db.Timestamptz(6)
  review_note  String?
  created_at   DateTime         @default(now()) @db.Timestamptz(6)
  updated_at   DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  template  MonitoringTemplate @relation(fields: [template_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checker   User               @relation("MonitoringLogCheckedBy", fields: [checked_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer  User?              @relation("MonitoringLogReviewedBy", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket    TicketLog?         @relation(fields: [ticket_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  handovers Handover[]

  // One log per slot; also serves "logs of a template by time".
  @@unique([template_id, scheduled_at])
  // Daily dashboards ("today's logs"), per-agent and per-reviewer lists,
  // and NOK counts.
  @@index([scheduled_at])
  @@index([checked_by])
  @@index([reviewed_by])
  @@index([result])
  @@index([ticket_id])
  @@map("monitoring_logs")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum HandoverCategory {
  Note
  Task
  Monitoring

  @@map("handover_category_enum")
}

enum RoutineStatus {
  Open
  Closed
  ReOpen
  Pending

  @@map("routine_status_enum")
}

enum MonitoringResult {
  OK
  NOK

  @@map("monitoring_result_enum")
}

enum TicketStatus {
  Open
  Closed
  Activity
  Meeting
  Pending
  ReOpen

  @@map("ticket_status_enum")
}
