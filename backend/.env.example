# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=3000
APP_NAME=nestjs-app
APP_URL=http://localhost:3000

# ==========================================
# Database
# ==========================================
DATABASE_URL="postgresql://username:password@your-public-domain:1234/mydatabase?schema=ctd_config"

# Optional. `prisma db seed` gives this password to every user that has none,
# so they can log in and change it via PATCH /auth/password. Min 8 characters.
SEED_DEFAULT_PASSWORD=

# ==========================================
# Authentication
# ==========================================
# At least 32 characters; the app refuses to start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# ==========================================
# CORS (comma-separated list of allowed origins)
# ==========================================
CORS_ORIGIN=http://localhost:3001

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=debug

# ==========================================
# API docs (Swagger UI at /docs, JSON at /docs-json)
# ==========================================
# Defaults to on outside production and off when NODE_ENV=production.
# SWAGGER_ENABLED=true
