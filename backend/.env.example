# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=3000
APP_NAME=nestjs-app
APP_URL=http://localhost:3000

# ==========================================
# Database
# ==========================================
DATABASE_URL="postgresql://username:password@your-public-domain:1234/mydatabase?schema=ctd_config"

# Optional. `prisma db seed` gives this password to every user that has none,
# so they can log in and change it via PATCH /auth/password. Min 8 characters.
SEED_DEFAULT_PASSWORD=

# ==========================================
# Authentication (login sessions)
# ==========================================
# Signs the ctd.sid session cookie. At least 32 characters; the app refuses to
# start otherwise. To rotate it without logging everyone out, put the new one
# first: SESSION_SECRET=new,old. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-secret
# Logged out this long after login, however active (30m, 12h, 7d...). Default 12h.
SESSION_MAX_AGE=12h
# Optional: also log out after this long without any request. Unset = off.
# SESSION_IDLE_TIMEOUT=2h

# Behind a reverse proxy (nginx, a load balancer...): which proxies to trust for
# X-Forwarded-For/-Proto: true, a hop count (1) or addresses (loopback, 10.0.0.0/8).
# Needed in production behind HTTPS termination, or the secure session cookie is
# never sent. Leave unset when clients connect directly.
# TRUST_PROXY=1

# ==========================================
# CORS (comma-separated list of allowed origins)
# ==========================================
# Browser origins that may call the API with the session cookie (the frontend).
# Writes (POST/PATCH/PUT/DELETE) from pages on any other origin are refused.
CORS_ORIGIN=http://localhost:3001

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=debug

# ==========================================
# API docs (Swagger UI at /docs, JSON at /docs-json)
# ==========================================
# Defaults to on outside production and off when NODE_ENV=production.
# SWAGGER_ENABLED=true
